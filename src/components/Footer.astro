---
import { SITE } from '../lib/site';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 px-4 py-6 text-center text-sm text-white/70">
  <p>{SITE.name} · © {year} · {t('footer.madeWith')} <a class="underline hover:text-white" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></p>
</footer>
