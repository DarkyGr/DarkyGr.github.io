---
import Icon from './Icon.astro';
import { getRepos } from '../lib/github';
import { SITE } from '../lib/site';
import { useTranslations } from '../i18n/ui';

const repos = await getRepos(SITE.github);
const t = useTranslations(Astro.currentLocale);
const fmt = new Intl.DateTimeFormat(Astro.currentLocale, { month: 'short', year: 'numeric' });
---

{
  repos.length > 0 && (
    <section id="projects" class="mx-auto max-w-6xl px-4 py-20" aria-labelledby="projects-title">
      <h2 id="projects-title" class="reveal mb-10 text-center text-[clamp(1.75rem,4vw,2.75rem)] font-bold">
        <span class="bg-gradient-to-r from-brand-3 via-brand-4 to-brand-5 bg-clip-text text-transparent">
          {t('projects.title')}
        </span>
      </h2>

      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {repos.map((r) => (
          <li class="reveal">
            <a
              href={r.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:-translate-y-1 hover:border-brand-4/60 hover:bg-white/[0.06]"
            >
              <h3 class="text-lg font-semibold break-words group-hover:text-brand-4">{r.name}</h3>
              <p class="mt-2 line-clamp-3 flex-1 text-sm text-white/70">
                {r.description ?? t('projects.noDescription')}
              </p>
              <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-white/60">
                {r.language && (
                  <span class="rounded-full bg-brand-2/40 px-2 py-0.5 text-white/90">{r.language}</span>
                )}
                <span class="inline-flex items-center gap-1">
                  <Icon name="star-outline" class="size-4" /> {r.stargazers_count}
                  <span class="sr-only">{t('projects.stars')}</span>
                </span>
                <span class="inline-flex items-center gap-1">
                  <Icon name="source-fork" class="size-4" /> {r.forks_count}
                  <span class="sr-only">{t('projects.forks')}</span>
                </span>
                <time class="ms-auto" datetime={r.pushed_at}>{fmt.format(new Date(r.pushed_at))}</time>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
